# Copy to .env.local for local builds. In CI and Cloudflare, set these as build environment variables.
# Every value is inlined at build time: change one, rebuild.

# Production origin. Canonical URLs, the sitemap and OG tags use it, even on preview deploys.
NEXT_PUBLIC_SITE_URL=https://getnami.dev

# Search engine indexing. Keep false until launch; true serves robots allow + the sitemap.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Set true once github.com/namphuongtran/nami is public. Until then CTAs say "Request early access".
NEXT_PUBLIC_REPO_PUBLIC=false
NEXT_PUBLIC_REPO_URL=https://github.com/namphuongtran/nami

# Contact. Without a form endpoint the contact page uses a mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=me@getnami.dev
NEXT_PUBLIC_CONTACT_FORM_ACTION=
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=

# Google Search Console HTML-tag verification (prefer DNS TXT verification on Cloudflare).
NEXT_PUBLIC_GSC_VERIFICATION=

# Analytics. Cloudflare Web Analytics is cookieless (no banner). GA4 shows a consent banner.
NEXT_PUBLIC_CF_BEACON_TOKEN=
NEXT_PUBLIC_GA_ID=
